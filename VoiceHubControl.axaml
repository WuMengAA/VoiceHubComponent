<ci:ComponentBase
    x:Class="VoiceHubComponent.VoiceHubControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:local="clr-namespace:VoiceHubComponent"
    xmlns:controls="clr-namespace:VoiceHubComponent.Controls"
    xmlns:fluent="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia">

    <Grid DataContext="{Binding $parent[local:VoiceHubControl]}">
        <!-- 加载中状态 -->
        <StackPanel Name="LoadingPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    IsVisible="{Binding IsLoading}">
            <fluent:ProgressRing Width="16" Height="16" Margin="0,0,8,0" IsIndeterminate="True" />
            <TextBlock Text="正在加载..."
                       FontSize="{DynamicResource MainWindowBodyFontSize}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 内容显示：左侧正在播放 + 右侧歌词，同一行 -->
        <Grid Name="ContentPanel"
              ColumnDefinitions="Auto,*"
              VerticalAlignment="Center"
              IsVisible="{Binding IsDataLoaded}">
            <!-- 左侧固定：正在播放（封面 + 歌名/歌手）+ 服务端广播叠加层 -->
            <Grid Name="NowPlayingPanel"
                  RowDefinitions="Auto,Auto"
                  VerticalAlignment="Center"
                  Margin="0,0,12,0"
                  IsVisible="False">
                <!-- 第一行：原卡片（封面 + 歌名/歌手） -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="Auto,Auto"
                      VerticalAlignment="Center">
                    <Border Name="CoverContainer"
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            Margin="0,0,8,0"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <!-- 内边距避免封面完全贴边；显式圆角裁剪保证图片不溢出圆角 -->
                        <Grid Margin="2">
                            <Grid.Clip>
                                <RectangleGeometry Rect="0,0,36,36" RadiusX="4" RadiusY="4"/>
                            </Grid.Clip>
                            <Image Name="BackCoverImage" Stretch="UniformToFill" Opacity="0"/>
                            <Image Name="FrontCoverImage" Stretch="UniformToFill" Opacity="0"/>
                            <ci:FluentIcon Name="CoverPlaceholder"
                                           Glyph="&#xE8D6;"
                                           FontSize="18"
                                           Opacity="0.45"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Column="1"
                                VerticalAlignment="Center"
                                MaxWidth="240">
                        <TextBlock Name="NowPlayingTitle"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Name="NowPlayingArtist"
                                   FontSize="11"
                                   Opacity="0.68"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Grid>

                <!-- 第二行：广播「正在播放」叠加层（默认隐藏；仅当服务端广播命中当前排期时显示） -->
                <Grid Name="NowPlayingOverlay"
                      Grid.Row="1"
                      Margin="0,4,0,0"
                      ColumnDefinitions="Auto,*,Auto"
                      IsVisible="False">
                    <Grid.Styles>
                        <Style Selector="Ellipse.pulsing">
                            <Style.Animations>
                                <Animation Duration="0:0:1.2" IterationCount="Infinite">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="Opacity" Value="1"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="Opacity" Value="0.25"/>
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </Grid.Styles>

                    <!-- 脉动「正在播放」徽标 -->
                    <Border Name="NowPlayingBadge"
                            Grid.Column="0"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            IsVisible="False">
                        <Ellipse Name="NowPlayingPulse"
                                 Width="8" Height="8"
                                 Fill="{DynamicResource SystemAccentColorBrush}"/>
                    </Border>

                    <!-- 实时进度条（本地每秒外推；暂停态冻结） -->
                    <ProgressBar Name="NowPlayingProgress"
                                 Grid.Column="1"
                                 Minimum="0" Maximum="1" Value="0"
                                 Height="3"
                                 VerticalAlignment="Center"
                                 IsVisible="False"/>

                    <!-- 「接下来」与「N 人在听」 -->
                    <StackPanel Name="NowPlayingMeta"
                                Grid.Column="2"
                                Orientation="Vertical"
                                VerticalAlignment="Center"
                                Margin="6,0,0,0">
                        <TextBlock Name="NowPlayingNext"
                                   FontSize="10"
                                   Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="False"/>
                        <TextBlock Name="NowPlayingListeners"
                                   FontSize="10"
                                   Opacity="0.7"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="False"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- 右侧：高级歌词 -->
            <controls:VoiceHubLyricsPresenter Name="LyricsPresenter"
                                              Grid.Column="1"
                                              VerticalAlignment="Center"
                                              IsVisible="False"/>

            <!-- 排期摘要（未开启歌词或未处于播放状态时显示） -->
            <TextBlock Name="SummaryText"
                       Grid.ColumnSpan="2"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="{DynamicResource MainWindowBodyFontSize}"
                       Text="{Binding ContentText}"/>
        </Grid>

        <!-- 错误状态 -->
        <StackPanel Name="ErrorPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    IsVisible="{Binding IsError}">
            <ci:FluentIcon Glyph="&#xE783;"
                           Width="16"
                           Height="16"
                           Foreground="Red"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"/>
            <TextBlock Name="ErrorText"
                       FontSize="{DynamicResource MainWindowBodyFontSize}"
                       VerticalAlignment="Center"
                       Foreground="Red"
                       Text="{Binding MessageText}"/>
        </StackPanel>
    </Grid>
</ci:ComponentBase>
